# --- Branding ---
# Display name used in server-generated strings (Nominatim User-Agent, etc.)
# and, via VITE_APP_NAME below, in the web app's UI copy. Renaming the
# project is a matter of changing these (plus mobile/.env's
# EXPO_PUBLIC_APP_NAME and directus/.env's APP_NAME/APP_BASE_URL/
# SERVICE_ACCOUNT_EMAIL) — see each file's comments.
APP_NAME=PinGather
VITE_APP_NAME=PinGather
# The home page's <title>/meta description/Open Graph tags are hardcoded
# directly in client/index.html, not templated from env vars — link
# previews (Slack, Twitter, etc.) unfurl the raw HTML without running any
# JS, so those tags must never depend on a build-time env var that might be
# missing in whatever environment produced the build. Edit client/index.html
# directly to change them.
# Username of the login-less directus_users row that owns this app's own
# curated /discover maps. Optional, defaults to "pingather" — only need to
# change this if you rename that account too (see directus/src/permissions/apply.ts).
CURATED_MAPS_SYSTEM_USERNAME=

# --- Directus (backend data store) ---
# URL of your Directus instance — either a local stack (`docker compose up
# -d`, http://localhost:8055) or an existing/hosted instance (shared with
# other projects is fine; see directus/.env.example).
DIRECTUS_URL=http://localhost:8055
# Static token for the narrowly-scoped "<APP_NAME> Service" role. Generated
# by `npm run directus:permissions:apply` on first run and printed to the
# console — paste it here.
DIRECTUS_SERVICE_TOKEN=
# Map invitation emails are NOT sent from this app server — a Directus Flow
# (provisioned by `npm run directus:flows:apply`, see directus/src/flows/)
# sends them, using Directus's own core mail transport (EMAIL_SMTP_* on the
# Directus instance itself, not an env var here). This app server has no
# path to that SMTP relay directly.

# --- Clerk (authentication) ---
# Publishable key, exposed to the browser (safe to share).
VITE_CLERK_PUBLISHABLE_KEY=
# Same publishable key, read server-side by @clerk/express (which does not
# read the VITE_-prefixed one) — set it to the same value as above.
CLERK_PUBLISHABLE_KEY=
# Secret key, server-only. Read automatically by @clerk/express.
CLERK_SECRET_KEY=
# Signing secret for the /api/webhooks/clerk endpoint (from the Clerk
# Dashboard > Webhooks). Optional for local dev — without it, users are
# still synced to Directus just-in-time on their first authenticated request.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Admin ---
# Comma-separated emails granted is_admin=true the first time they sign in.
ADMIN_EMAILS=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Anthropic (AI-generated venue suggestions on the import page) ---
# Optional — without it, the "Generate with AI" import option returns a
# clear "not configured" error instead of failing unexpectedly.
ANTHROPIC_API_KEY=

# --- Stripe (subscription billing) ---
# Optional — without STRIPE_SECRET_KEY, the /pricing page's checkout and
# billing-portal buttons return a clear "not configured" error instead of
# failing unexpectedly.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (Stripe Dashboard >
# Developers > Webhooks). Required for subscription status changes
# (upgrades, downgrades, cancellations) to actually update a user's plan.
STRIPE_WEBHOOK_SECRET=
# Price ids for the Basic/Premium recurring Prices (Stripe Dashboard >
# Product catalog). Each plan's "Upgrade" button is disabled with a clear
# error until its price id is set.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=

# --- Server ---
PORT=5000
NODE_ENV=development
