# Copy to .env and fill in. EXPO_PUBLIC_* vars are inlined into the app
# bundle at build time (readable by anyone who inspects the app), so only
# put publishable/public keys here — never secrets.

# Base URL of the Express API (server/ at the repo root). Point this at your
# local dev server (find your machine's LAN IP if testing on a physical
# device — "localhost" resolves to the device itself, not your computer) or
# the deployed Vercel URL.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Clerk publishable key — same Clerk project as the web app
# (client/.env's VITE_CLERK_PUBLISHABLE_KEY), so accounts are shared across
# web and mobile. Find it in the Clerk dashboard under API Keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps SDK keys for react-native-maps — these are DIFFERENT from the
# web app's Maps JavaScript API key (server/.env's GOOGLE_MAPS_API_KEY):
# native apps need "Maps SDK for iOS" / "Maps SDK for Android" enabled and
# restricted to this app's bundle ID / package name + SHA-1, not an HTTP
# referrer restriction. Not EXPO_PUBLIC_-prefixed since they're read at
# native-build time by app.config.ts, not from the JS bundle.
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=
